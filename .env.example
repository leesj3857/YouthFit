YOUTHCENTER_API_KEY=your-youthcenter-api-key
# 청핏 RAG 추천 (/api/chat)
ANTHROPIC_API_KEY=sk-ant-...
# 선택: 모델 변경 (기본 claude-haiku-5-5 / claude-sonnet-5-5)
# PARSE_MODEL=claude-haiku-5-5
# REC_MODEL=claude-sonnet-5-5
# 선택: off 로 두면 임베딩 없이 키워드 검색만 사용
# RAG_EMBEDDINGS=off
# 호출 제한 (공개 배포 시 필수) — https://console.upstash.com 에서 Redis 생성 후 REST 값 복사
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 선택: 하루 호출 한도 (기본 IP당 40, 전체 400)
# RATE_LIMIT_PER_IP=40
# RATE_LIMIT_GLOBAL=400
