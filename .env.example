# 백엔드 API 주소 (공개 API). 비워두면 개발 서버(https://youthfit-api.onrender.com)를 쓴다
# 로컬 백엔드를 쓸 때: NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=
# 추천 평가(👍/👎) 저장 — https://console.upstash.com 에서 Redis 생성 후 REST 값 복사 (없으면 저장하지 않고 로그만 남김)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 선택: 피드백 호출 제한용 IP 해시 솔트
# RATE_LIMIT_SALT=
# 기존 정책 목록 화면(/api/policies)용 온통청년 키
YOUTHCENTER_API_KEY=your-youthcenter-api-key
